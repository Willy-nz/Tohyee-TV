{
  "manifest_version": 3,
  "name": "Tohyee TV",
  "version": "0.7.4",
  "minimum_chrome_version": "116",
  "description": "Broadcast a Chrome tab's picture and sound to Plex through the Tohyee TV tuner on this computer.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Tohyee TV",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "spitz-16.png",
      "32": "spitz-32.png",
      "48": "spitz-48.png",
      "128": "spitz-128.png"
    }
  },
  "icons": {
    "16": "spitz-16.png",
    "32": "spitz-32.png",
    "48": "spitz-48.png",
    "128": "spitz-128.png"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
