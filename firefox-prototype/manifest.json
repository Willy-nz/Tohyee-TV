{
  "manifest_version": 2,
  "name": "Tohyee TV Capture Check",
  "version": "0.1.0.2",
  "description": "Local, user-selected window/screen capture preview. No streaming or recording. Checks GitHub for newer test builds.",
  "browser_specific_settings": {"gecko": {"id": "capture-check@tohyee-tv.local"}},
  "browser_action": {"default_title": "Open Tohyee TV Capture Check", "default_icon": "spitz.svg"},
  "icons": {"48": "spitz.svg", "96": "spitz.svg"},
  "background": {"scripts": ["background.js"]},
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src https://api.github.com"
}
